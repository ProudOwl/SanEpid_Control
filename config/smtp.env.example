# Gmail (рекомендуется): smtp.gmail.com, порт 587, SMTP_TLS=1, SMTP_SSL=0 + пароль приложения
# Yandex: smtp.yandex.ru, порт 465, SMTP_TLS=0, SMTP_SSL=1
# Mail.ru: smtp.mail.ru

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=SanEpid Control <your_email@gmail.com>
SMTP_TLS=1
SMTP_SSL=0
